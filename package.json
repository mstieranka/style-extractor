{
  "name": "style-extractor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test-dev": "vitest dev",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "format": "biome format",
    "lint": "biome lint",
    "compare-llm": "tsx compare-llm-results.ts",
    "sb:login": "supabase login",
    "sb:generate-types": "supabase gen types typescript --project-id vciodekmnrtxbarvojjo --schema public > src/lib/frontend/supabaseTypes.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.102.1",
    "@tabler/icons-svelte-runes": "3.41.1",
    "@zerodevx/svelte-toast": "0.9.6",
    "colorjs.io": "0.5.2",
    "css-tree": "3.1.0",
    "prettier": "3.7.4",
    "random": "5.4.1",
    "sv-router": "0.15.0",
    "svelte": "5.46.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.1",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@tailwindcss/vite": "4.1.16",
    "@tsconfig/svelte": "5.0.5",
    "@types/css-tree": "2.3.11",
    "@types/node": "24.6.0",
    "playwright": "1.57.0",
    "supabase": "2.87.2",
    "svelte-check": "4.3.5",
    "tailwindcss": "4.1.16",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.0",
    "vitest": "4.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  }
