{
	"name": "style-extractor",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.20.0",
	"engines": {
		"node": ">=22.16.0"
	},
	"scripts": {
		"dev": "pnpm --filter @style-extractor/frontend dev",
		"build": "pnpm --filter @style-extractor/frontend build",
		"preview": "pnpm --filter @style-extractor/frontend preview",
		"test": "pnpm -r run test",
		"format": "biome format .",
		"lint": "biome lint .",
		"compare-llm": "tsx scripts/compare-llm-results.ts",
		"get-palette-names": "tsx scripts/get-palette-names.ts",
		"optimize-images": "pnpm --filter @style-extractor/frontend optimize-images",
		"frontend:login": "pnpm --filter @style-extractor/frontend sb:login",
		"frontend:generate-types": "pnpm --filter @style-extractor/frontend sb:generate-types"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@types/node": "25.6.0",
		"playwright": "1.59.1",
		"prettier": "3.8.3",
		"tsx": "4.21.0",
		"typescript": "6.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"supabase"
		]
	}
}
